# Two different secrets. The tool key goes into Lyzr Studio's custom tools;
# the admin key stays with you (web page, curl). Never reuse one for the other.
TOOL_KEY=change-me-tool
ADMIN_KEY=change-me-admin

# Sandbox repo (the only files the agent can ever touch) and workflow DB
SANDBOX_DIR=../sandbox
DB_PATH=./steward.db

# Lyzr Studio (leave blank to run the backend without KB sync or /chat)
LYZR_API_KEY=
LYZR_AGENT_ID=
LYZR_KB_ID=
LYZR_USER_ID=repo-steward-admin
# Endpoints follow the Lyzr API docs (train/text, rag/{id}/reset, v3/inference/chat).
LYZR_CHAT_URL=https://agent-prod.studio.lyzr.ai/v3/inference/chat/
LYZR_RAG_URL=https://rag-prod.studio.lyzr.ai/v3

# incremental = add/remove per file on approve; rebuild = wipe + re-ingest after each approve
KB_SYNC_MODE=incremental

# Public tunnel URL, written into the tool spec's `servers` entry (Studio needs an absolute base URL).
# Leave blank to derive it from the request that fetches /tool-openapi.json.
PUBLIC_URL=
