# Secrets and local config (keep the template)
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/

# Local workflow state: approval queue, KB map and audit log
*.db
*.db-journal
*.db-wal
*.db-shm

# Generated spec; embeds the current tunnel URL, regenerate from /tool-openapi.json
tool-openapi.json

# Sandbox: the repo the agent manages. It is third-party code that approvals modify,
# so only the empty folder is tracked. See the README for how to fill it.
sandbox/*
!sandbox/.gitkeep

# Internal planning doc, kept local
PRD*.md

# Tunnel binaries and logs
cloudflared*
*.log

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp
